msgstr "IMC - Cet extension calcule l'Indice de Masse Corporelle."

#: addon\globalPlugins\BMI\__init__.py:76
msgid "Calculation of the Body Mass Index."
msgstr "Calcul de l'Indice de Masse Corporelle."

